# Django
DJANGO_SECRET_KEY=CHANGE_ME
# Desenvolvimento: config.settings.development
# Produção:        config.settings.production  (exige as variáveis da seção "Implantação")
DJANGO_SETTINGS_MODULE=config.settings.development

# Segredos: todo valor CHANGE_ME abaixo é obrigatório e DEVE ser trocado por um valor
# aleatório e único por instância — em produção o serviço se recusa a subir com
# CHANGE_ME ou vazio. Gerar: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Segredos: DJANGO_SECRET_KEY, JWT_SIGNING_KEY, INTERNAL_API_TOKEN, MCP_API_TOKEN,
# POSTGRES_PASSWORD, S3_SECRET_KEY, GARAGE_RPC_SECRET. (ANTHROPIC_API_KEY é opcional.)

# ── Implantação (produção) ───────────────────────────────────────────────────
# Uso: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
# Identidade desta instância (aparece em /health) e versão (ex.: git sha).
INSTANCIA_NOME=
IA_VERSION=
# Nomes e origens pelos quais o portal é acessado (separados por vírgula).
# ALLOWED_HOSTS=host.tailnet.ts.net,ia.exemplo.com.br
# CSRF_TRUSTED_ORIGINS=https://host.tailnet.ts.net,https://ia.exemplo.com.br
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
# O que existe na frente do portal: proxy (HTTPS terminado por tailscale serve ou
# Caddy; padrão) ou none (HTTP puro — só teste local ou rede fechada, por decisão).
TLS_MODE=proxy
# HSTS é pegajoso no navegador; 0 = desligado. Só ligar (ex.: 31536000) com HTTPS estável.
SECURE_HSTS_SECONDS=0
# Cadastro público: ABERTO por padrão em qualquer ambiente (o primeiro cadastro vira o administrador;
# quem vem depois ganha uma organização só sua). false = fecha o cadastro depois do primeiro usuário.
# Num host PÚBLICO use false; na tailnet o padrão serve.
# REGISTRO_ABERTO=true
# Interface onde as portas 8000/8001 são publicadas. Loopback por padrão; sem proxy,
# o IP da tailnet do host. Nunca 0.0.0.0 sem decisão consciente.
BIND_ADDR=127.0.0.1
# Onde ficam os dados (postgres, garage, qdrant, redis). Pode apontar para outro disco.
DATA_DIR=./data
# Versão do Garage (armazenamento S3), embutida na imagem de infra/garage.
GARAGE_VERSION=v2.4.1
# Origens web aceitas pelo orchestrator (CORS); vazio = nenhuma. A extensão não precisa.
# CORS_ALLOWED_ORIGINS=
# OPCIONAL: dono inicial criado pelo bootstrap (só se ainda não houver usuários), com as TRÊS definidas.
# DEIXE VAZIAS para você mesmo ser o administrador: o primeiro cadastro em /registro/ vira o dono
# (faça esse cadastro antes de expor a porta).
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
# Só no host com domínio público (profile "publico", Caddy): docker compose ... --profile publico up -d
# IA_DOMINIO=ia.exemplo.com.br
# ACME_EMAIL=voce@exemplo.com.br

# Segurança / Autenticação
# JWT_SIGNING_KEY: segredo compartilhado entre portal (assina) e orchestrator
# (valida) os tokens JWT da extensão. DEVE ser idêntico nos dois serviços.
JWT_SIGNING_KEY=CHANGE_ME
# INTERNAL_API_TOKEN: segredo do canal serviço-a-serviço (orchestrator → portal).
INTERNAL_API_TOKEN=CHANGE_ME
# MCP_API_TOKEN: exigido no header X-Mcp-Token para chamar as ferramentas do MCP
# (/tools/*). O Swagger em /docs fica público (fins didáticos), mas as chamadas
# reais exigem este token — ver services/mcp/main.py.
MCP_API_TOKEN=CHANGE_ME

# PostgreSQL
POSTGRES_DB=inteligencia_aberta
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Garage (armazenamento S3 compatível). O serviço `garage` importa esta chave e cria
# os buckets no primeiro boot (infra/garage/entrypoint.sh) — não há console de admin.
# Formatos exigidos pelo Garage:
#   S3_ACCESS_KEY   = GK + 24 hex   → echo "GK$(openssl rand -hex 12)"
#   S3_SECRET_KEY   = 64 hex        → openssl rand -hex 32
#   GARAGE_RPC_SECRET = 64 hex      → openssl rand -hex 32
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
GARAGE_RPC_SECRET=CHANGE_ME
# Token da API de admin do Garage: só o garage-webui de dev usa (openssl rand -hex 32).
# Sem ele a API de admin fica desativada — é o que se quer em produção.
# GARAGE_ADMIN_TOKEN=
# Capacidade declarada do nó único (só equilibra dados entre nós; não reserva disco).
# GARAGE_CAPACITY=100GB
# Vazio = "garage:3900" (nome do serviço no docker-compose). Máquina de
# cluster que não roda Garage local aponta isto pra primária.
S3_ENDPOINT=garage:3900

# Redis — broker/result backend do Celery (db 0) e channel layer do
# painel de eventos em tempo real (db 1, ver CHANNEL_LAYER_URL).
REDIS_URL=redis://redis:6379/0
CHANNEL_LAYER_URL=redis://redis:6379/1

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# LLM externo (opcional na Fase 0 para dados públicos)
# Chave global (fallback). A forma preferida é por organização: Admin → "LLM providers"
# (tipo Externo, fornecedor Anthropic) — a da organização vence esta.
ANTHROPIC_API_KEY=
# Cifra, em repouso, as chaves cadastradas por organização. Opcional: vazio deriva de
# DJANGO_SECRET_KEY (trocá-lo invalida as chaves salvas). Gerar:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ATENÇÃO: defina ANTES do primeiro `up` — a chave Ed25519 da instância (federação,
# ADR 010) também é cifrada com ela e vira ilegível se a cifra mudar depois.
# FIELD_ENCRYPTION_KEY=
LLM_CLASSIFIER_MODEL=claude-haiku-4-5
LLM_EXTRACTOR_MODEL=claude-sonnet-5

# Cluster (apps.cluster) — ver docs/operacao/escala-multimaquina.md e as ADR 006/009.
# Cada instância é completa (banco e armazenamento próprios); o cluster cuida só do
# roteamento de LLM entre máquinas e do heartbeat. Replicar dados entre instâncias é a
# federação (ADR 010).
#
# CLUSTER_MACHINE_ID: opcional. Só preencha para fixar explicitamente qual `Maquina` esta
# instância representa (necessário se houver mais de uma Organization). Sem ele, a própria
# instância se autorregistra.
CLUSTER_MACHINE_ID=
# Nome desta máquina — o heartbeat usa isto para se autorregistrar sozinho como Maquina
# na primeira vez que rodar, sem cadastro manual. Só tem efeito com
# exatamente uma Organization cadastrada. Precisa ser estável entre reinícios de
# container — nunca use o hostname do container (muda a cada `docker compose up`).
CLUSTER_LOCAL_APELIDO=
# Enrolamento de pares (ADR 011): o endereço pelo qual os OUTROS pares alcançam ESTA
# instância — o IP da VPN (Tailscale) e a porta do portal. Vai no convite. Só HTTP em rede
# privada/VPN; fora dela use https. O Caddy bloqueia /federacao/* (é canal de VPN/LAN).
FEDERACAO_ENDPOINT_ANUNCIADO=
# Tolerância de relógio entre instâncias, em segundos (exige NTP nas duas pontas).
# FEDERACAO_JANELA_RELOGIO_S=60
# Permite par por HTTP em endereço público (desaconselhado).
# FEDERACAO_PERMITE_HTTP_PUBLICO=false
# Cache (nonces do canal assinado, anti-replay). Padrão: o Redis do compose, banco 2.
# CACHE_URL=redis://redis:6379/2
# Limite de requisições por minuto de cada par ao canal de controle.
# FEDERACAO_LIMITE_POR_MINUTO=120
# Controle dos modelos do Ollama pela tela /cluster/ (ver docs/operacao/escala-multimaquina.md):
# espaço (GB) que deve sobrar no volume do Ollama depois de instalar um modelo.
# OLLAMA_RESERVA_DISCO_GB=10
# Onde está o diretório de modelos do Ollama, no HOST, para medir o espaço livre. Container: o padrão
# (${DATA_DIR}/ollama) serve. Ollama NATIVO: aponte para o ~/.ollama (ex.: /Users/voce/.ollama).
# Sem isso o espaço livre é "desconhecido" e o pull não é bloqueado por falta de disco.
# OLLAMA_DATA_DIR_HOST=
# Aceita instalar modelo de um registry que não é o oficial (nome com host: `host/usuario/modelo`). Desaconselhado.
# OLLAMA_PERMITE_REGISTRY_EXTERNO=false
# Segredo do gateway compatível com OpenAI em POST /v1/chat/completions
# (apps.cluster.gateway) — só fala com Ollama das máquinas do cluster, nunca
# com provider externo. Vazio = gateway desligado (404).
LLM_GATEWAY_TOKEN=
# Base (sem /v1) que esta máquina ANUNCIA aos peers para chegarem ao gateway acima pela
# VPN, ex.: http://100.x.y.z:8000. É por ele que os peers devem chamar o LLM desta máquina
# (ADR 009), em vez de expor o Ollama sem autenticação. Vazio = não anuncia.
# LLM_GATEWAY_ENDPOINT_ANUNCIADO=

# Ollama — usado para estruturação manual e comparação no visualizador com dados
# restrito/confidencial, que nunca podem usar LLM externo. É uma capacidade do NÓ
# (ADR 009): cada máquina escolhe UM dos três modos abaixo.
#
#  nativo (padrão; Macs — o Docker não acessa a GPU Metal): Ollama instalado no host.
#    OLLAMA_HOST=http://host.docker.internal:11434
#    (host.docker.internal:host-gateway, em docker-compose.yml, resolve para o host)
#  container (Linux; CPU ou NVIDIA via docker-compose.gpu.yml): o compose sobe o Ollama.
#    COMPOSE_PROFILES=ollama
#    OLLAMA_HOST=http://ollama:11434
#    OLLAMA_MODELOS="qwen3.5:9b"   # baixados no `up` (ollama-pull); vazio = nenhum
#  nenhum (VPS pequena, sem GPU): sem LLM local, usa os peers do cluster.
#    OLLAMA_HOST=
OLLAMA_HOST=http://host.docker.internal:11434
# O que esta máquina ANUNCIA aos peers (heartbeat → Maquina.ollama_endpoint): precisa ser
# alcançável por outro nó, ex.: http://100.x.y.z:11434 (IP da VPN). Vazio = usa OLLAMA_HOST,
# o que só serve em máquina única — `http://ollama:11434` não existe fora do compose.
# OLLAMA_ENDPOINT_ANUNCIADO=
# Modo container: onde publicar a porta do Ollama no host. Loopback por padrão; para o
# cluster alcançá-lo, o IP da VPN — o Ollama não tem autenticação, nunca 0.0.0.0.
# OLLAMA_BIND_ADDR=127.0.0.1
# OLLAMA_PORTA=11434
# OLLAMA_VERSION=0.35.1
OLLAMA_TIMEOUT_S=120
# Default do Ollama é 4096 mesmo em modelos com contexto maior — em modelos
# "thinking" o raciocínio sozinho pode estourar isso antes da resposta final.
OLLAMA_NUM_CTX=4096
# Threads de CPU usadas pelo Ollama em toda chamada, qualquer modelo — vazio
# usa todas as CPUs visíveis pelo container (os.cpu_count()). Só defina um
# número menor se quiser deixar CPU de folga para outra coisa na máquina.
# Ver infra/ollama/Modelfile-qwen-max para fixar o mesmo ajuste direto no
# modelo, para uso fora do app via `ollama run` (`ollama create qwen3.5:9b-max
# -f infra/ollama/Modelfile-qwen-max`).
OLLAMA_NUM_THREAD=

# --- Ultima Agora: workspaces colaborativos (opcional; `docker compose --profile agora up`) ---
# Sem AGORA_SYNC_URL o Agora funciona, mas cada workspace fica só no navegador de quem o criou.
# AGORA_SYNC_URL é o endereço do agora-sync COMO O NAVEGADOR O VÊ: ws://host:8787 (direto) ou
# wss://ia.exemplo.com.br/agora-sync (atrás do Caddy).
# AGORA_SYNC_URL=
# Segredo HS256 compartilhado entre o portal (assina os tokens) e o agora-sync (valida); >= 32 caracteres.
# AGORA_SYNC_SECRET=CHANGE_ME
# Canal portal → agora-sync para valer mudança de papel nas conexões abertas (opcional; token >= 16 caracteres).
# AGORA_SYNC_ADMIN_URL=http://agora-sync:8787
# AGORA_SYNC_ADMIN_TOKEN=CHANGE_ME
# Chat do Agora: por quantos dias o agora-sync guarda as mensagens (0 = para sempre). O log é compactado ao abrir.
# CHAT_RETENTION_DAYS=0
# Offline-first: TETO do nível de classificação que o navegador de cada usuário pode guardar para trabalhar sem rede
# (nenhum | publico | interno | restrito | confidencial). Padrão: restrito. Cada pessoa escolhe o próprio nível em
# Configurações → Dados neste dispositivo, até este teto (o padrão de cada um é interno). É decisão de segurança: o que fica
# guardado viaja com o dispositivo e o IndexedDB não é cifrado; `confidencial` só vale com cifra em repouso.
# AGORA_OFFLINE_CACHE_NIVEL=restrito
