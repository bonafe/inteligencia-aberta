# Django
DJANGO_SECRET_KEY=CHANGE_ME
# Desenvolvimento: config.settings.development
# Produção:        config.settings.production  (exige as variáveis da seção "Implantação")
DJANGO_SETTINGS_MODULE=config.settings.development

# Segredos: todo valor CHANGE_ME abaixo é obrigatório e DEVE ser trocado por um valor
# aleatório e único por instância — em produção o serviço se recusa a subir com
# CHANGE_ME ou vazio. Gerar: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Segredos: DJANGO_SECRET_KEY, JWT_SIGNING_KEY, INTERNAL_API_TOKEN, MCP_API_TOKEN,
# POSTGRES_PASSWORD, MINIO_ROOT_PASSWORD. (ANTHROPIC_API_KEY é opcional.)

# ── Implantação (produção) ───────────────────────────────────────────────────
# Uso: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
# Identidade desta instância (aparece em /health) e versão (ex.: git sha).
INSTANCIA_NOME=
IA_VERSION=
# Nomes e origens pelos quais o portal é acessado (separados por vírgula).
# ALLOWED_HOSTS=host.tailnet.ts.net,ia.exemplo.com.br
# CSRF_TRUSTED_ORIGINS=https://host.tailnet.ts.net,https://ia.exemplo.com.br
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
# O que existe na frente do portal: proxy (HTTPS terminado por tailscale serve ou
# Caddy; padrão) ou none (HTTP puro — só teste local ou rede fechada, por decisão).
TLS_MODE=proxy
# HSTS é pegajoso no navegador; 0 = desligado. Só ligar (ex.: 31536000) com HTTPS estável.
SECURE_HSTS_SECONDS=0
# Cadastro público: em produção fecha após o primeiro usuário; true = sempre aberto.
# REGISTRO_ABERTO=false  # padrão: false em produção, true em desenvolvimento
# Interface onde as portas 8000/8001 são publicadas. Loopback por padrão; sem proxy,
# o IP da tailnet do host. Nunca 0.0.0.0 sem decisão consciente.
BIND_ADDR=127.0.0.1
# Onde ficam os dados (postgres, minio, qdrant, redis). Pode apontar para outro disco.
DATA_DIR=./data
# Imagem do MinIO (fixar uma tag RELEASE.* em produção).
MINIO_IMAGE=quay.io/minio/minio:latest
# Origens web aceitas pelo orchestrator (CORS); vazio = nenhuma. A extensão não precisa.
# CORS_ALLOWED_ORIGINS=
# Dono inicial da instância, criado pelo bootstrap (só se ainda não houver usuários).
# Sem estas três, nenhum superusuário é criado e o primeiro cadastro em /registro/ vira o dono.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=CHANGE_ME
# Só no host com domínio público (profile "publico", Caddy): docker compose ... --profile publico up -d
# IA_DOMINIO=ia.exemplo.com.br
# ACME_EMAIL=voce@exemplo.com.br

# Segurança / Autenticação
# JWT_SIGNING_KEY: segredo compartilhado entre portal (assina) e orchestrator
# (valida) os tokens JWT da extensão. DEVE ser idêntico nos dois serviços.
JWT_SIGNING_KEY=CHANGE_ME
# INTERNAL_API_TOKEN: segredo do canal serviço-a-serviço (orchestrator → portal).
INTERNAL_API_TOKEN=CHANGE_ME
# MCP_API_TOKEN: exigido no header X-Mcp-Token para chamar as ferramentas do MCP
# (/tools/*). O Swagger em /docs fica público (fins didáticos), mas as chamadas
# reais exigem este token — ver services/mcp/main.py.
MCP_API_TOKEN=CHANGE_ME

# PostgreSQL
POSTGRES_DB=inteligencia_aberta
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=db
POSTGRES_PORT=5432

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME
# Vazio = "minio:9000" (nome do serviço no docker-compose). Máquina de
# cluster que não roda MinIO local aponta isto pra primária.
MINIO_ENDPOINT=minio:9000

# Redis — broker/result backend do Celery (db 0) e channel layer do
# painel de eventos em tempo real (db 1, ver CHANNEL_LAYER_URL).
REDIS_URL=redis://redis:6379/0
CHANNEL_LAYER_URL=redis://redis:6379/1

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# LLM externo (opcional na Fase 0 para dados públicos)
ANTHROPIC_API_KEY=
LLM_CLASSIFIER_MODEL=claude-haiku-4-5
LLM_EXTRACTOR_MODEL=claude-sonnet-5

# Cluster multi-máquina (apps.cluster) — ver docs/operacao/escala-multimaquina.md
# e docs/arquitetura/decisoes/006-cluster-adaptativo-multiproprietario.md.
# Não existe "máquina primária" no vocabulário do cluster — só capacidade:
# uma máquina hospeda (ou não) a infraestrutura compartilhada.
#
# CLUSTER_MACHINE_ID/CLUSTER_MACHINE_TOKEN: preenchidos automaticamente por
# `scripts/entrar_no_cluster.py` numa máquina que ENTROU no cluster de outra.
# Vazios na máquina que hospeda a infra — ela não precisa disso, ver
# CLUSTER_LOCAL_APELIDO abaixo.
CLUSTER_MACHINE_ID=
CLUSTER_MACHINE_TOKEN=
# Nome desta máquina quando ELA MESMA hospeda a infra compartilhada — o
# heartbeat usa isto pra se autorregistrar sozinho como Maquina na primeira
# vez que rodar, sem precisar de `manage.py registrar_maquina` manual contra
# si mesma. Só tem efeito com CLUSTER_HOSPEDA_INFRA=true e exatamente uma
# Organization cadastrada. Precisa ser estável entre reinícios de container
# — nunca use o hostname do container (muda a cada `docker compose up`).
CLUSTER_LOCAL_APELIDO=
# CLUSTER_HOSPEDA_INFRA=true (default) roda o catch-up scan do pipeline;
# toda máquina que só contribui processamento deve usar
# CLUSTER_HOSPEDA_INFRA=false para não duplicá-lo. Também é o que esta
# máquina reporta em /cluster/api/v1/status/ — é assim que
# scripts/entrar_no_cluster.py descobre qual peer do tailnet tem a infra.
CLUSTER_HOSPEDA_INFRA=true
# Segredo único do cluster — defina uma vez na máquina que hospeda a infra,
# distribua pra quem for rodar scripts/entrar_no_cluster.py numa máquina
# nova. Vazio = ninguém consegue se autorregistrar (404), continua
# precisando de `manage.py registrar_maquina` manual.
CLUSTER_JOIN_SECRET=
# Filas Celery que esta máquina atende (`-Q`, ver docker-compose.worker-node.yml).
# Vazio = fila padrão só.
CELERY_QUEUES=
# IP desta máquina na VPN (Tailscale/WireGuard) — usado só por
# docker-compose.no-infraestrutura.yml para publicar Postgres/Redis/MinIO/Qdrant
# apenas na interface da VPN, nunca em 0.0.0.0.
CLUSTER_VPN_BIND_IP=
# Segredo do gateway compatível com OpenAI em POST /v1/chat/completions
# (apps.cluster.gateway) — só fala com Ollama das máquinas do cluster, nunca
# com provider externo. Vazio = gateway desligado (404).
LLM_GATEWAY_TOKEN=

# Ollama (nativo no host, fora do Docker) — usado para estruturação manual e
# comparação no visualizador com dados restrito/confidencial, que nunca podem
# usar LLM externo. host.docker.internal:host-gateway (docker-compose.yml)
# resolve para o host a partir dos containers portal/worker.
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_TIMEOUT_S=120
# Default do Ollama é 4096 mesmo em modelos com contexto maior — em modelos
# "thinking" o raciocínio sozinho pode estourar isso antes da resposta final.
OLLAMA_NUM_CTX=4096
# Threads de CPU usadas pelo Ollama em toda chamada, qualquer modelo — vazio
# usa todas as CPUs visíveis pelo container (os.cpu_count()). Só defina um
# número menor se quiser deixar CPU de folga para outra coisa na máquina.
# Ver infra/ollama/Modelfile-qwen-max para fixar o mesmo ajuste direto no
# modelo, para uso fora do app via `ollama run` (`ollama create qwen3.5:9b-max
# -f infra/ollama/Modelfile-qwen-max`).
OLLAMA_NUM_THREAD=
