{
  "manifest_version": 3,
  "name": "Captura Inteligência Aberta",
  "version": "1.0",
  "description": "Captura páginas web em MHTML para o portal Inteligência Aberta.",
  "permissions": [
    "activeTab",
    "pageCapture",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8001/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
